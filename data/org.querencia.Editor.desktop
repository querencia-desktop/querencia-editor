[Desktop Entry]
# Querencia Editor. Desktop-ID = GApplication-ID org.querencia.Editor, damit
# labwc und die Fensterliste Titelleistensymbol und Namen finden.
# Vorlage: Name, GenericName, Comment und Keywords sind englisch; die
# Übersetzungen (Name[de]= …) setzt `werkzeug/i18n.py desktop` aus po/*.po
# ein (entspricht msgfmt --desktop). Erzeugt: org.querencia.Editor.desktop.
# Menüname „Text Editor“/„Texteditor“ (Zubehör) wie bisher; der
# Fenstertitel bleibt „Querencia Editor“. MimeType: die zehn hervorgehobenen
# Formate (txt/conf/ini → text/plain, md, json, xml, sh, py, rs, c/h).
Type=Application
Version=1.5
Name[de]=Texteditor
Name[es]=Editor de textos
Name[fr]=Éditeur de texte
Name[it]=Editor di testo
Name=Text Editor
GenericName[de]=Texteditor
GenericName[es]=Editor de textos
GenericName[fr]=Éditeur de texte
GenericName[it]=Editor di testo
GenericName=Text Editor
Comment[de]=Textdateien bearbeiten
Comment[es]=Editar archivos de texto
Comment[fr]=Modifier des fichiers texte
Comment[it]=Modifica file di testo
Comment=Edit text files
Exec=querencia-editor %U
TryExec=querencia-editor
Icon=org.querencia.Editor
Terminal=false
Categories=GTK;Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-markdown;application/json;application/xml;text/xml;application/x-shellscript;text/x-shellscript;text/x-python;text/x-python3;text/rust;text/x-csrc;text/x-chdr;
Keywords[de]=Text;Editor;Texteditor;Notizen;
Keywords[es]=Texto;Editor;Bloc de notas;Notas;
Keywords[fr]=Texte;Éditeur;Bloc-notes;Notes;
Keywords[it]=Testo;Editor;Blocco note;Note;
Keywords=Text;Editor;Notepad;Notes;
StartupNotify=true
StartupWMClass=org.querencia.Editor
